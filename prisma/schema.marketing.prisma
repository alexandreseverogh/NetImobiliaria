generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Todos os modelos vivem em campanhasmarketingdigital (via search_path no PrismaPg adapter).
// Queries em public.* usam prisma.$queryRaw com schema qualificado.

model MarketingInitiative {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  name                String    @db.VarChar(200)
  description         String?
  goalDescription     String?   @map("goal_description")
  totalBudgetPlanned  Decimal?  @map("total_budget_planned") @db.Decimal(12, 2)
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String    @default("PLANNED") @db.VarChar(20)
  primaryKpi          String?   @map("primary_kpi") @db.VarChar(40)
  primaryKpiTarget    Decimal?  @map("primary_kpi_target")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid

  campaigns Campaign[]

  @@index([tenantId, status])
  @@index([clientId])
  @@map("MarketingInitiative")
}

model Campaign {
  id                  String    @id @default(uuid())
  tenantId            String?   @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  metaCampaignId      String?   @unique
  name                String
  objective           String
  status              String    @default("PAUSED")
  specialAdCategory   String?
  initiativeId        String?   @map("initiative_id") @db.Uuid
  initiative          MarketingInitiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  // FASE 4 — lifecycle
  lifecycleStatus     String    @default("DRAFT") @map("lifecycle_status") @db.VarChar(20)
  lifecycleChangedAt  DateTime? @map("lifecycle_changed_at")
  learningStartedAt   DateTime? @map("learning_started_at")
  stableSince         DateTime? @map("stable_since")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adSets             AdSet[]
  lifecycleEvents    CampaignLifecycleEvent[]

  @@index([tenantId])
  @@index([clientId])
  @@index([initiativeId])
  @@index([lifecycleStatus, tenantId])
}

model CampaignLifecycleEvent {
  id              String    @id @default(uuid())
  campaignId      String    @map("campaign_id")
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId        String?   @map("tenant_id") @db.Uuid
  fromStatus      String?   @map("from_status") @db.VarChar(20)
  toStatus        String    @map("to_status") @db.VarChar(20)
  triggerSource   String    @map("trigger_source") @db.VarChar(20)
  reason          String?
  metricsSnapshot Json?     @map("metrics_snapshot")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([tenantId])
  @@map("CampaignLifecycleEvent")
}

model AdSet {
  id                String    @id @default(uuid())
  metaAdSetId       String?   @unique
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  dailyBudget       Int
  startTime         DateTime
  endTime           DateTime?
  optimizationGoal  String
  billingEvent      String    @default("IMPRESSIONS")
  ageMin            Int       @default(18)
  ageMax            Int       @default(65)
  genders           Int[]
  locations         Json
  interests         Json?
  scheduleDays      Int[]
  scheduleStartHour Int?
  scheduleEndHour   Int?
  scheduleTimeSlots Json?
  createdAt         DateTime  @default(now())
  ads               Ad[]
}

model Ad {
  id           String   @id @default(uuid())
  metaAdId     String?  @unique
  adSetId      String
  adSet        AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name         String
  status       String   @default("PAUSED")
  creativeType String
  images       String[]
  body         String
  headline     String?
  linkUrl      String?
  ctaType      String   @default("LEARN_MORE")
  trackingId   String?  @unique
  createdAt    DateTime @default(now())
}

model Insight {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id") @db.Uuid
  campaignId       String
  adSetId          String?
  adId             String?
  date             DateTime
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  spend            Float    @default(0)
  cpc              Float?
  cpm              Float?
  ctr              Float?
  conversions      Int      @default(0)
  frequency        Float?
  engagement       Int      @default(0)
  videoViews       Int?
  // FASE 5 — Video Metrics
  videoViews3s     Int      @default(0) @map("video_views_3s")
  videoViews15s    Int      @default(0) @map("video_views_15s")
  videoViews25Pct  Int      @default(0) @map("video_views_25_pct")
  videoViews50Pct  Int      @default(0) @map("video_views_50_pct")
  videoViews75Pct  Int      @default(0) @map("video_views_75_pct")
  videoViews100Pct Int      @default(0) @map("video_views_100_pct")
  thruplayViews    Int      @default(0) @map("thruplay_views")
  breakdowns       Json?
  createdAt        DateTime @default(now())

  @@index([campaignId, date])
  @@index([tenantId])
}

model WhatsAppConfig {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") @db.Uuid
  phoneNumber    String
  defaultMessage String
  businessName   String?
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

model Lead {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id") @db.Uuid
  clientId     String?  @map("client_id") @db.Uuid
  campaignId   String?
  adId         String?
  phoneClicked String
  sourceUrl    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  ipAddress    String?
  userAgent    String?
  clickedAt    DateTime @default(now())

  @@index([campaignId, clickedAt])
  @@index([tenantId])
  @@index([clientId])
}

model AiInsight {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") @db.Uuid
  campaignId  String
  type        String
  title       String
  description String
  confidence  Float
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model AgentAction {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") @db.Uuid
  campaignId   String
  campaignName String
  type         String
  title        String
  description  String
  confidence   Float
  status       String    @default("PENDING_APPROVAL")
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([campaignId, createdAt])
  @@index([tenantId])
}

model Settings {
  id            String  @id @default(uuid())
  tenantId      String? @unique @map("tenant_id") @db.Uuid
  creativesPath String?
  publicDomain  String?
  llmProvider   String  @default("anthropic")
  llmModel      String  @default("claude-sonnet-4-6")
  llmApiKey     String?
}

model LlmModel {
  id             String   @id @default(uuid())
  provider       String
  providerLabel  String   @map("provider_label")
  modelId        String   @map("model_id")
  modelLabel     String   @map("model_label")
  baseUrl        String?  @map("base_url")
  qualityScore   Int      @default(3) @map("quality_score")
  isFree         Boolean  @default(false) @map("is_free")
  contextWindow  Int?     @map("context_window")
  isRecommended  Boolean  @default(false) @map("is_recommended")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now())

  @@index([provider])
  @@index([isActive])
  @@map("LlmModel")
}

model StrategicBriefing {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  type      String
  content   Json
  summary   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([clientId])
}

model CreativeAsset {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id") @db.Uuid
  clientId      String?   @map("client_id") @db.Uuid
  originalName  String    @map("original_name")
  storagePath   String    @map("storage_path")
  storageUrl    String    @map("storage_url")
  fileSize      Int?      @map("file_size")
  mimeType      String?   @default("image/jpeg") @map("mime_type")
  format        String?   @default("image")
  width         Int?
  height        Int?
  hash          String?
  campaignId    String?   @map("campaign_id")
  adId          String?   @map("ad_id")
  isActive      Boolean   @default(true) @map("is_active")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")

  analysis      CreativeAnalysis?

  @@index([tenantId])
  @@index([hash])
  @@map("CreativeAsset")
}

model CreativeAnalysis {
  id                  String    @id @default(uuid())
  assetId             String    @unique @map("asset_id")
  tenantId            String    @map("tenant_id") @db.Uuid

  hasPeople           Boolean   @default(false) @map("has_people")
  hasProperty         Boolean   @default(false) @map("has_property")
  hasTextOverlay      Boolean   @default(false) @map("has_text_overlay")
  isUgcStyle          Boolean   @default(false) @map("is_ugc_style")
  isCorporateStyle    Boolean   @default(false) @map("is_corporate_style")

  hookType            String?   @map("hook_type") @db.VarChar(50)
  emotionalTone       String?   @map("emotional_tone") @db.VarChar(50)
  angle               String?   @db.VarChar(50)
  ctaStyle            String?   @map("cta_style") @db.VarChar(20)

  bodyWordCount       Int       @default(0) @map("body_word_count")
  headlineWordCount   Int       @default(0) @map("headline_word_count")
  hasEmoji            Boolean   @default(false) @map("has_emoji")
  hasPrice            Boolean   @default(false) @map("has_price")
  hasUrgencyWords     Boolean   @default(false) @map("has_urgency_words")

  sceneDescription    String?   @map("scene_description")
  keyVisualElements   String[]  @map("key_visual_elements")

  analyzedAt          DateTime  @default(now()) @map("analyzed_at")
  llmModelUsed        String?   @map("llm_model_used") @db.VarChar(100)
  llmConfidence       Decimal?  @map("llm_confidence") @db.Decimal(3, 2)
  rawAnalysis         Json?     @map("raw_analysis")
  analysisStatus      String    @default("pending") @map("analysis_status") @db.VarChar(20)
  errorMessage        String?   @map("error_message")

  asset               CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([tenantId])
  @@map("CreativeAnalysis")
}
