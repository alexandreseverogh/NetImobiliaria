generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Todos os modelos vivem em campanhasmarketingdigital (via search_path no PrismaPg adapter).
// Queries em public.* usam prisma.$queryRaw com schema qualificado.

model MarketingInitiative {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  name                String    @db.VarChar(200)
  description         String?
  goalDescription     String?   @map("goal_description")
  totalBudgetPlanned  Decimal?  @map("total_budget_planned") @db.Decimal(12, 2)
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String    @default("PLANNED") @db.VarChar(20)
  primaryKpi          String?   @map("primary_kpi") @db.VarChar(40)
  primaryKpiTarget    Decimal?  @map("primary_kpi_target")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid

  campaigns Campaign[]

  @@index([tenantId, status])
  @@index([clientId])
  @@map("MarketingInitiative")
}

// FASE 16 — Postagem orgânica (separada do fluxo pago de Campaign/Ad)
model OrganicPost {
  id              String                     @id @default(uuid())
  tenantId        String                     @map("tenant_id") @db.Uuid
  clientId        String?                    @map("client_id") @db.Uuid
  platform        String                     @db.VarChar(20)
  format          String                     @db.VarChar(20)
  caption         String?
  mediaUrls       Json                       @default("[]") @map("media_urls")
  assetIds        Json?                      @map("asset_ids")
  mediaKind       String?                    @map("media_kind") @db.VarChar(10)
  status          String                     @default("DRAFT") @db.VarChar(20)
  externalPostId  String?                    @map("external_post_id") @db.VarChar(100)
  permalinkUrl    String?                    @map("permalink_url")
  scheduledAt     DateTime?                  @map("scheduled_at")
  publishedAt     DateTime?                  @map("published_at")
  errorMessage    String?                    @map("error_message")
  createdBy       String?                    @map("created_by") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at")
  recurrenceId    String?                    @map("recurrence_id") @db.Uuid

  recurrence      OrganicRecurrenceSchedule? @relation(fields: [recurrenceId], references: [id])

  @@index([tenantId, status])
  @@index([clientId])
  @@index([recurrenceId])
  @@map("OrganicPost")
}

// FASE 16.G — Agendamento recorrente de publicações orgânicas
model OrganicRecurrenceSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  platform       String   @db.VarChar(20)
  format         String   @db.VarChar(20)
  caption        String?
  mediaUrls      Json     @default("[]") @map("media_urls")
  mediaKind      String?  @map("media_kind") @db.VarChar(10)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  daysOfWeek     Json     @default("[]") @map("days_of_week")  // [0-6], 0=Dom
  timeslots      Json     @default("[]")                        // ['09:00','14:00']
  status         String   @default("ACTIVE") @db.VarChar(20)   // ACTIVE|PAUSED|CANCELLED|COMPLETED
  generatedUntil DateTime? @map("generated_until")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  posts          OrganicPost[]

  @@index([tenantId, status])
  @@map("OrganicRecurrenceSchedule")
}

model Campaign {
  id                  String    @id @default(uuid())
  tenantId            String?   @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  metaCampaignId      String?   @unique
  name                String
  objective           String
  status              String    @default("PAUSED")
  specialAdCategory   String?
  initiativeId        String?   @map("initiative_id") @db.Uuid
  initiative          MarketingInitiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  // FASE 4 — lifecycle
  lifecycleStatus     String    @default("DRAFT") @map("lifecycle_status") @db.VarChar(20)
  lifecycleChangedAt  DateTime? @map("lifecycle_changed_at")
  learningStartedAt   DateTime? @map("learning_started_at")
  stableSince         DateTime? @map("stable_since")
  // FASE 7 — funnel stage
  funnelStage         String    @default("TOF") @map("funnel_stage") @db.VarChar(20)
  // FASE 14 — ângulo de comunicação declarado no lançamento (opcional; taxonomia compartilhada)
  declaredAngle       String?   @map("declared_angle") @db.VarChar(50)
  // Multi-rede (Meta/Google/LinkedIn/TikTok) — FK para public.ad_networks; ambas as colunas já
  // existiam no banco sem estar mapeadas aqui (schema drift). network_metadata continua via
  // raw SQL (pool.query), sem necessidade de mexer agora.
  networkId           String?   @map("network_id") @db.Uuid
  externalId           String?  @map("external_id") @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adSets             AdSet[]
  lifecycleEvents    CampaignLifecycleEvent[]

  @@index([tenantId])
  @@index([clientId])
  @@index([initiativeId])
  @@index([lifecycleStatus, tenantId])
}

model CampaignLifecycleEvent {
  id              String    @id @default(uuid())
  campaignId      String    @map("campaign_id")
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId        String?   @map("tenant_id") @db.Uuid
  fromStatus      String?   @map("from_status") @db.VarChar(20)
  toStatus        String    @map("to_status") @db.VarChar(20)
  triggerSource   String    @map("trigger_source") @db.VarChar(20)
  reason          String?
  metricsSnapshot Json?     @map("metrics_snapshot")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([tenantId])
  @@map("CampaignLifecycleEvent")
}

model AdSet {
  id                String    @id @default(uuid())
  metaAdSetId       String?   @unique
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  dailyBudget       Int
  startTime         DateTime
  endTime           DateTime?
  optimizationGoal  String
  billingEvent      String    @default("IMPRESSIONS")
  ageMin            Int       @default(18)
  ageMax            Int       @default(65)
  genders           Int[]
  locations         Json
  interests         Json?
  scheduleDays      Int[]
  scheduleStartHour Int?
  scheduleEndHour   Int?
  scheduleTimeSlots Json?
  createdAt         DateTime  @default(now())
  ads               Ad[]
}

model Ad {
  id           String   @id @default(uuid())
  metaAdId     String?  @unique
  adSetId      String
  adSet        AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name         String
  status       String   @default("PAUSED")
  creativeType String
  images       String[]
  body         String
  headline     String?
  linkUrl      String?
  ctaType      String   @default("LEARN_MORE")
  trackingId   String?  @unique
  createdAt    DateTime @default(now())
}

model Insight {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id") @db.Uuid
  campaignId       String
  adSetId          String?
  adId             String?
  date             DateTime
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  spend            Float    @default(0)
  cpc              Float?
  cpm              Float?
  ctr              Float?
  conversions      Int      @default(0)
  frequency        Float?
  engagement       Int      @default(0)
  videoViews       Int?
  // FASE 5 — Video Metrics
  videoViews3s     Int      @default(0) @map("video_views_3s")
  videoViews15s    Int      @default(0) @map("video_views_15s")
  videoViews25Pct  Int      @default(0) @map("video_views_25_pct")
  videoViews50Pct  Int      @default(0) @map("video_views_50_pct")
  videoViews75Pct  Int      @default(0) @map("video_views_75_pct")
  videoViews100Pct Int      @default(0) @map("video_views_100_pct")
  thruplayViews    Int      @default(0) @map("thruplay_views")
  // FASE 8.5 — Signal-Driven Anticipation (sinais de diagnóstico do Meta)
  qualityRanking         String?  @map("quality_ranking") @db.VarChar(20)
  engagementRateRanking  String?  @map("engagement_rate_ranking") @db.VarChar(20)
  conversionRateRanking  String?  @map("conversion_rate_ranking") @db.VarChar(20)
  learningStatus         String?  @map("learning_status") @db.VarChar(20)
  learningConversions    Int?     @map("learning_conversions")
  firstImpressionRatio   Float?   @map("first_impression_ratio")
  breakdowns       Json?
  // FASE 1 (Google Ads) — Impression Share + ROAS (grão campanha-dia)
  searchImpressionShare  Float    @default(0) @map("search_impression_share")
  searchBudgetLostIs     Float    @default(0) @map("search_budget_lost_is")
  searchRankLostIs       Float    @default(0) @map("search_rank_lost_is")
  conversionsValue       Float    @default(0) @map("conversions_value")
  createdAt        DateTime @default(now())

  @@index([campaignId, date])
  @@index([tenantId])
}

// FASE 1 (Google Ads) — grão termo de busca (não cabe em Insight, que é campanha-dia)
model GoogleSearchTerm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  campaignId  String   @map("campaign_id")
  adNetwork   String   @default("google") @map("ad_network") @db.VarChar(20)

  searchTerm  String   @map("search_term") @db.VarChar(255)
  matchType   String   @map("match_type") @db.VarChar(20)

  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  conversions Int      @default(0)

  status      String   @default("none") @db.VarChar(20)  // 'none' | 'negated' | 'added_as_keyword'

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, campaignId, searchTerm, date])
  @@index([campaignId, date])
  @@index([tenantId])
  @@map("GoogleSearchTerm")
}

// FASE 1 (Google Ads) — memória do que já foi negativado (evita o agente propor 2x)
model GoogleNegativeKeyword {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  campaignId String   @map("campaign_id")

  term       String   @db.VarChar(255)
  matchType  String   @map("match_type") @db.VarChar(20)
  addedBy    String   @map("added_by") @db.VarChar(20)  // 'agent' | 'human'
  addedAt    DateTime @default(now()) @map("added_at")

  @@unique([tenantId, campaignId, term])
  @@index([campaignId])
  @@map("GoogleNegativeKeyword")
}

// FASE 8.5 — Snapshot de calibração (cache do painel + auditoria)
model CalibrationSignal {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String?  @map("client_id") @db.Uuid
  campaignId    String   @map("campaign_id")
  adId          String?  @map("ad_id")
  adsetId       String?  @map("adset_id")
  pressureScore Int      @map("pressure_score")
  signals       Json
  recommendation Json?
  anticipation  Json?
  source        String   @default("META_SIGNAL") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, campaignId, createdAt(sort: Desc)])
  @@map("CalibrationSignal")
}

model WhatsAppConfig {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") @db.Uuid
  phoneNumber    String
  defaultMessage String
  businessName   String?
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

/// Fonte única de cliques/atribuição de CTA (substitui o antigo model "Lead", que só cobria
/// cliques em anúncios lançados por esta plataforma, sem atribuição real na resposta do
/// WhatsApp). Populada por /api/r/[trackingId] (clique em anúncio) e pelo processador de
/// mensagens WhatsApp entrantes (resposta atribuída via "[ref:...]"). "Lead" de verdade
/// (fonte canônica multi-módulo) continua sendo public.leads_staging — ver
/// docs/PLANO_UNIFICACAO_LEADS_3_MODULOS.md §9.1.
model CtaInteraction {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String?  @map("client_id") @db.Uuid
  destinationId String?  @map("destination_id") @db.Uuid
  campaignId    String?  @map("campaign_id")
  adId          String?  @map("ad_id")
  ctaType       String?  @map("cta_type")
  eventType     String   @default("VIEW") @map("event_type")
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  utmContent    String?  @map("utm_content")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  referrer      String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([campaignId, createdAt])
  @@index([tenantId, createdAt])
  @@index([destinationId, createdAt])
  @@map("CtaInteraction")
}

model AiInsight {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") @db.Uuid
  campaignId  String
  type        String
  title       String
  description String
  confidence  Float
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model AgentAction {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id") @db.Uuid
  campaignId      String
  campaignName    String
  type            String
  title           String
  description     String
  confidence      Float
  status          String    @default("PENDING_APPROVAL")
  executedAt      DateTime?
  createdAt       DateTime  @default(now())
  approvalPin     String?   @map("approval_pin") @db.VarChar(6)
  approvalPinExp  DateTime? @map("approval_pin_exp")

  @@index([campaignId, createdAt])
  @@index([tenantId])
}

// docs/PLANO_TIKTOK.md §5.2/§8 — motor de realocação cross-rede (T4). AgentAction modela só
// 1 campanha; esta tabela carrega o detalhe bilateral (origem + destino) de uma proposta de
// realocação, vinculada a uma AgentAction (agentActionId) que serve de anchor de aprovação/PIN.
model BudgetReallocation {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  segmentId           String?   @map("segment_id") @db.Uuid

  sourceCampaignId    String    @map("source_campaign_id")
  sourceCampaignName  String    @map("source_campaign_name")
  sourceNetwork       String    @map("source_network") @db.VarChar(20)
  sourceCplBefore     Float     @map("source_cpl_before")
  sourceBudgetBefore  Int       @map("source_budget_before")
  sourceBudgetAfter   Int?      @map("source_budget_after")

  targetCampaignId    String    @map("target_campaign_id")
  targetCampaignName  String    @map("target_campaign_name")
  targetNetwork       String    @map("target_network") @db.VarChar(20)
  targetCplBefore     Float     @map("target_cpl_before")
  targetBudgetBefore  Int       @map("target_budget_before")
  targetBudgetAfter   Int?      @map("target_budget_after")

  amountCents         Int       @map("amount_cents")
  gapPct              Float     @map("gap_pct")
  projectedLeadGain   Float     @map("projected_lead_gain")
  confidence          Float

  status              String    @default("PROPOSED")
  agentActionId       String?   @map("agent_action_id")

  measuredAt          DateTime? @map("measured_at")
  actualLeadGain      Float?    @map("actual_lead_gain")
  verdict             String?

  createdAt           DateTime  @default(now()) @map("created_at")
  executedAt          DateTime? @map("executed_at")

  @@index([tenantId, createdAt])
  @@index([sourceCampaignId, targetCampaignId, createdAt])
  @@index([agentActionId])
  @@map("BudgetReallocation")
}

model Settings {
  id              String  @id @default(uuid())
  tenantId        String? @unique @map("tenant_id") @db.Uuid
  creativesPath   String?
  publicDomain    String?
  llmProvider     String  @default("anthropic")
  llmModel        String  @default("claude-sonnet-4-6")
  llmApiKey       String?
  imageProvider   String? @map("imageProvider")
  imageModel      String? @map("imageModel")
  imageApiKey     String? @map("imageApiKey")
}

model LlmModel {
  id             String   @id @default(uuid())
  provider       String
  providerLabel  String   @map("provider_label")
  modelId        String   @map("model_id")
  modelLabel     String   @map("model_label")
  baseUrl        String?  @map("base_url")
  qualityScore   Int      @default(3) @map("quality_score")
  isFree         Boolean  @default(false) @map("is_free")
  contextWindow  Int?     @map("context_window")
  isRecommended  Boolean  @default(false) @map("is_recommended")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now())

  @@index([provider])
  @@index([isActive])
  @@map("LlmModel")
}

model StrategicBriefing {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  segmentId   String?  @map("segment_id") @db.Uuid
  segmentName String?  @map("segment_name")
  type        String
  periodDays  Int?     @map("period_days")
  content     Json
  summary     String
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, segmentId])
}

model CreativeAsset {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id") @db.Uuid
  clientId      String?   @map("client_id") @db.Uuid
  originalName  String    @map("original_name")
  storagePath   String    @map("storage_path")
  storageUrl    String    @map("storage_url")
  fileSize      Int?      @map("file_size")
  mimeType      String?   @default("image/jpeg") @map("mime_type")
  format        String?   @default("image")
  width         Int?
  height        Int?
  hash          String?
  campaignId    String?   @map("campaign_id")
  adId          String?   @map("ad_id")
  isActive           Boolean   @default(true) @map("is_active")
  uploadedAt         DateTime  @default(now()) @map("uploaded_at")

  // FASE 6.5 — rastreabilidade de variações geradas por IA
  aiGenerated        Boolean   @default(false) @map("ai_generated")
  derivedFromAssetId String?   @map("derived_from_asset_id")

  analysis      CreativeAnalysis?

  @@index([tenantId])
  @@index([hash])
  @@map("CreativeAsset")
}

model CreativeAnalysis {
  id                  String    @id @default(uuid())
  assetId             String    @unique @map("asset_id")
  tenantId            String    @map("tenant_id") @db.Uuid

  hasPeople           Boolean   @default(false) @map("has_people")
  hasProperty         Boolean   @default(false) @map("has_property")
  hasTextOverlay      Boolean   @default(false) @map("has_text_overlay")
  isUgcStyle          Boolean   @default(false) @map("is_ugc_style")
  isCorporateStyle    Boolean   @default(false) @map("is_corporate_style")

  hookType            String?   @map("hook_type") @db.VarChar(50)
  emotionalTone       String?   @map("emotional_tone") @db.VarChar(50)
  angle               String?   @db.VarChar(50)
  ctaStyle            String?   @map("cta_style") @db.VarChar(20)

  bodyWordCount       Int       @default(0) @map("body_word_count")
  headlineWordCount   Int       @default(0) @map("headline_word_count")
  hasEmoji            Boolean   @default(false) @map("has_emoji")
  hasPrice            Boolean   @default(false) @map("has_price")
  hasUrgencyWords     Boolean   @default(false) @map("has_urgency_words")

  sceneDescription    String?   @map("scene_description")
  keyVisualElements   String[]  @map("key_visual_elements")

  analyzedAt          DateTime  @default(now()) @map("analyzed_at")
  llmModelUsed        String?   @map("llm_model_used") @db.VarChar(100)
  llmConfidence       Decimal?  @map("llm_confidence") @db.Decimal(3, 2)
  rawAnalysis         Json?     @map("raw_analysis")
  analysisStatus      String    @default("pending") @map("analysis_status") @db.VarChar(20)
  errorMessage        String?   @map("error_message")

  asset               CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([tenantId])
  @@map("CreativeAnalysis")
}

// FASE 8 — Tracking Health Monitor
model TrackingHealthCheck {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id") @db.Uuid
  clientId     String?  @map("client_id") @db.Uuid
  overallScore Int      @map("overall_score")
  checks       Json     // CheckResult[]
  issues       Json     // HealthIssue[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("TrackingHealthCheck")
}

// FASE 15 — Agentes: Garantia de Execução
model AgentHeartbeat {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id") @db.Uuid
  triggeredBy     String    @default("cron") @map("triggered_by")  // 'cron' | 'manual' | 'api'
  cycleAt         DateTime  @default(now()) @map("cycle_at")
  durationMs      Int?      @map("duration_ms")
  campaignsSynced Int       @default(0) @map("campaigns_synced")
  actionsCreated  Int       @default(0) @map("actions_created")
  success         Boolean   @default(true)
  errorMessage    String?   @map("error_message")

  @@index([cycleAt(sort: Desc)])
  @@index([tenantId, cycleAt(sort: Desc)])
  @@map("AgentHeartbeat")
}

// FASE 9 — Audit Report Estruturado
model AuditReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  clientId     String?  @map("client_id") @db.Uuid
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  overallScore Int?     @map("overall_score")
  scorecard    Json     @default("{}")
  problems     Json     @default("[]")
  opportunities Json    @default("[]")
  wastedSpend  Json     @map("wasted_spend") @default("{}")
  actionPlan   Json     @map("action_plan") @default("[]")
  narrative    String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, clientId, periodStart, periodEnd], name: "uq_audit_report")
  @@index([tenantId, periodStart(sort: Desc)])
  @@map("AuditReport")
}

// FASE 6.5 — Produção de Criativos por Reaproveitamento (Estágio A)
model CreativeTemplate {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id") @db.Uuid   // NULL = template global
  name      String
  style     String   @default("corporate")         // 'ugc' | 'corporate'
  layout    Json                                   // zonas: headline, body, cta, logo + tipografia/cores
  formats   String[] @default([])                  // ['1:1','9:16','4:5']
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  jobs      CreativeGenerationJob[]

  @@index([tenantId])
  @@map("CreativeTemplate")
}

model CreativeGenerationJob {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id") @db.Uuid
  sourceAssetId String    @map("source_asset_id")   // CreativeAsset.id (TEXT)
  templateId    String?   @map("template_id")
  concept       Json?                               // { headline, body, cta } opcional
  formats       String[]  @default([])              // formatos solicitados
  status        String    @default("PENDING")        // PENDING | RUNNING | NEEDS_REVIEW | APPROVED | REJECTED | FAILED
  outputUrls    String[]  @default([]) @map("output_urls")  // URLs das variações no S3
  costCents     Int       @default(0) @map("cost_cents")
  errorMessage  String?   @map("error_message")
  createdBy     String?   @map("created_by") @db.Uuid
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  template      CreativeTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([sourceAssetId])
  @@map("CreativeGenerationJob")
}

