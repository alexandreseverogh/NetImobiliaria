generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Todos os modelos vivem em campanhasmarketingdigital (via search_path no PrismaPg adapter).
// Queries em public.* usam prisma.$queryRaw com schema qualificado.

model MarketingInitiative {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id") @db.Uuid
  clientId            String?   @map("client_id") @db.Uuid
  name                String    @db.VarChar(200)
  description         String?
  goalDescription     String?   @map("goal_description")
  totalBudgetPlanned  Decimal?  @map("total_budget_planned") @db.Decimal(12, 2)
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String    @default("PLANNED") @db.VarChar(20)
  primaryKpi          String?   @map("primary_kpi") @db.VarChar(40)
  primaryKpiTarget    Decimal?  @map("primary_kpi_target")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid

  campaigns Campaign[]

  @@index([tenantId, status])
  @@index([clientId])
  @@map("MarketingInitiative")
}

model Campaign {
  id                String    @id @default(uuid())
  tenantId          String?   @map("tenant_id") @db.Uuid
  clientId          String?   @map("client_id") @db.Uuid
  metaCampaignId    String?   @unique
  name              String
  objective         String
  status            String    @default("PAUSED")
  specialAdCategory String?
  initiativeId      String?   @map("initiative_id") @db.Uuid
  initiative        MarketingInitiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  adSets AdSet[]

  @@index([tenantId])
  @@index([clientId])
  @@index([initiativeId])
}

model AdSet {
  id                String    @id @default(uuid())
  metaAdSetId       String?   @unique
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  dailyBudget       Int
  startTime         DateTime
  endTime           DateTime?
  optimizationGoal  String
  billingEvent      String    @default("IMPRESSIONS")
  ageMin            Int       @default(18)
  ageMax            Int       @default(65)
  genders           Int[]
  locations         Json
  interests         Json?
  scheduleDays      Int[]
  scheduleStartHour Int?
  scheduleEndHour   Int?
  scheduleTimeSlots Json?
  createdAt         DateTime  @default(now())
  ads               Ad[]
}

model Ad {
  id           String   @id @default(uuid())
  metaAdId     String?  @unique
  adSetId      String
  adSet        AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name         String
  status       String   @default("PAUSED")
  creativeType String
  images       String[]
  body         String
  headline     String?
  linkUrl      String?
  ctaType      String   @default("LEARN_MORE")
  trackingId   String?  @unique
  createdAt    DateTime @default(now())
}

model Insight {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") @db.Uuid
  campaignId  String
  adSetId     String?
  adId        String?
  date        DateTime
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  cpc         Float?
  cpm         Float?
  ctr         Float?
  conversions Int      @default(0)
  frequency   Float?
  engagement  Int      @default(0)
  videoViews  Int?
  breakdowns  Json?
  createdAt   DateTime @default(now())

  @@index([campaignId, date])
  @@index([tenantId])
}

model WhatsAppConfig {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") @db.Uuid
  phoneNumber    String
  defaultMessage String
  businessName   String?
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

model Lead {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id") @db.Uuid
  clientId     String?  @map("client_id") @db.Uuid
  campaignId   String?
  adId         String?
  phoneClicked String
  sourceUrl    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  ipAddress    String?
  userAgent    String?
  clickedAt    DateTime @default(now())

  @@index([campaignId, clickedAt])
  @@index([tenantId])
  @@index([clientId])
}

model AiInsight {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") @db.Uuid
  campaignId  String
  type        String
  title       String
  description String
  confidence  Float
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model AgentAction {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") @db.Uuid
  campaignId   String
  campaignName String
  type         String
  title        String
  description  String
  confidence   Float
  status       String    @default("PENDING_APPROVAL")
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([campaignId, createdAt])
  @@index([tenantId])
}

model Settings {
  id            String  @id @default(uuid())
  tenantId      String? @unique @map("tenant_id") @db.Uuid
  creativesPath String?
  publicDomain  String?
  llmProvider   String  @default("anthropic")
  llmModel      String  @default("claude-sonnet-4-6")
  llmApiKey     String?
}

model LlmModel {
  id             String   @id @default(uuid())
  provider       String
  providerLabel  String   @map("provider_label")
  modelId        String   @map("model_id")
  modelLabel     String   @map("model_label")
  baseUrl        String?  @map("base_url")
  qualityScore   Int      @default(3) @map("quality_score")
  isFree         Boolean  @default(false) @map("is_free")
  contextWindow  Int?     @map("context_window")
  isRecommended  Boolean  @default(false) @map("is_recommended")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now())

  @@index([provider])
  @@index([isActive])
  @@map("LlmModel")
}

model StrategicBriefing {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  type      String
  content   Json
  summary   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([clientId])
}
