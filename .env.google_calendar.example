# ─── Google Calendar Integration ─────────────────────────────────────────────
# Obtenha em: https://console.cloud.google.com > APIs & Services > Credentials

# OAuth 2.0 (para calendário do usuário/corretor) — GOOGLE_CLIENT_ID/SECRET valem pra
# produção E staging ao mesmo tempo (mesmo Client OAuth, mesmo valor no .env único).
# Não existe GOOGLE_REDIRECT_URI aqui de propósito — o callback é derivado em runtime de
# NEXT_PUBLIC_APP_URL (src/lib/google/calendarService.ts), que já é correto por instância.
# ⚠️ Passo manual único no Google Cloud Console (Credentials → o Client OAuth → "URIs de
# redirecionamento autorizados"): cadastre um URI por domínio real usado, ex:
#   http://localhost:3000/api/auth/google/callback        (dev)
#   https://seudominio.com.br/api/auth/google/callback     (produção)
#   https://staging.seudominio.com.br/api/auth/google/callback  (staging)
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# Service Account — JSON completo da chave (para calendário da empresa)
# Cole o conteúdo inteiro do arquivo .json baixado do Google Cloud Console.
# ⚠️ Envolva com ASPAS SIMPLES (como no exemplo abaixo) — sem elas, o script de deploy
# (scripts/deploy.sh faz `source .env` em bash) interpreta as aspas duplas internas do JSON
# como delimitador e as remove, corrompendo o valor antes mesmo de chegar ao container.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"nome@projeto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
#
# ⚠️ Passo extra OBRIGATÓRIO, fora do .env — sem ele, a chave acima sozinha NÃO basta:
# o calendário identificado por `tenants.google_email` (configurado em /admin/master/tenants,
# por empresa) precisa ser compartilhado MANUALMENTE com o `client_email` de dentro do JSON
# acima, com permissão "Fazer alterações em eventos":
#   1. Abra calendar.google.com logado na conta dona de `tenants.google_email`
#   2. Configurações → [o calendário certo] → "Compartilhar com pessoas específicas"
#   3. Adicionar pessoas → cole o client_email (ex: nome@projeto.iam.gserviceaccount.com)
#   4. Permissão: "Fazer alterações em eventos"
# Repita esse passo pra cada tenant/empresa que usar o calendário da empresa (a chave da
# Service Account é única e compartilhada por toda a plataforma; o compartilhamento do
# calendário é por tenant).

# ─── SMTP / E-mail ────────────────────────────────────────────────────────────
# Configure com seu provedor de e-mail (Gmail, Zoho, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_do_gmail
SMTP_FROM_NAME=CRM Agenda
