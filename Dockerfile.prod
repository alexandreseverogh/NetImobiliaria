# =============================================================
# Dockerfile.prod — Multi-stage build para CI/CD
# Etapa 1 (builder): instala deps + compila Next.js
# Etapa 2 (runner):  copia standalone output (sem reinstalar node_modules)
# =============================================================

# ---- Etapa 1: Builder ----
FROM node:20-bookworm-slim AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Instalar dependências (inclui devDeps necessárias para o build — ex.: o CLI do
# Prisma, usado logo abaixo). NODE_ENV=production só é setado DEPOIS do npm ci:
# setá-lo antes faz o npm ci pular devDependencies silenciosamente, quebrando
# "npx prisma generate" (achado real neste deploy — ele caía para baixar um
# prisma@latest isolado, que não resolve prisma.config.ts corretamente).
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --include=dev && npm cache clean --force

ENV NODE_ENV=production

# Copiar código fonte
COPY . .

# Gerar o Prisma Client ANTES do build — sem isso, next build quebra em qualquer
# rota que importe @prisma/client (ex.: /api/admin/campanhas/briefings/generate),
# porque node_modules/.prisma/client nunca chega a existir. Não existe postinstall
# no package.json fazendo isso sozinho (localmente sempre foi rodado manualmente,
# nunca dentro de um build de Docker de verdade até este deploy — achado real,
# não hipotético, no primeiro deploy real deste código pra produção).
RUN npx prisma generate --schema=prisma/schema.marketing.prisma

# Compilar o Next.js (gera .next/standalone graças ao output: 'standalone' no next.config.js).
# Heap do Node fixado explicitamente — sem isso, o build já derrubou o processo com
# "JavaScript heap out of memory" num ambiente de teste com pouca RAM disponível pro
# container; runners de CI comuns (ex.: GitHub Actions, 7GB) suportam esse valor com folga.
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

# ---- Etapa 2: Runner ----
FROM node:20-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Criar usuário não-root
RUN groupadd -r nodejs && useradd -r -g nodejs nextjs

# Copiar artefatos do standalone build (já inclui node_modules mínimas necessárias)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copiar scripts auxiliares
COPY --from=builder /app/scripts ./scripts

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
