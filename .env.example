# ============================================================
# .env.example — Variáveis de ambiente para deploy na VPS
# Copie para .env e preencha os valores reais antes do deploy.
# NUNCA commite o arquivo .env com valores reais.
# ============================================================

# ── Domínios ────────────────────────────────────────────────
PROD_DOMAIN=app.seudominio.com.br
STAGING_DOMAIN=staging.seudominio.com.br
LETSENCRYPT_EMAIL=seu@email.com

# ── Banco de dados — Produção ────────────────────────────────
PROD_DB_NAME=net_imobiliaria
PROD_DB_PASSWORD=senha_segura_aqui
DB_USER=postgres

# ── Banco de dados — Staging ─────────────────────────────────
STAGING_DB_NAME=net_imobiliaria_staging
STAGING_DB_PASSWORD=senha_staging_aqui

# ── Auth ─────────────────────────────────────────────────────
PROD_JWT_SECRET=hex_64_chars_aqui
STAGING_JWT_SECRET=hex_64_chars_aqui

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_senha_aqui

# ── MinIO (Object Storage) ───────────────────────────────────
# Credenciais do MinIO — usadas tanto pelo container minio
# quanto pelos apps (prod_app e staging_app).
# CDN_URL é derivado automaticamente via PROD_DOMAIN/STAGING_DOMAIN
# no docker-compose.vps.yml — NÃO precisa ser definido manualmente.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=senha_minio_segura_aqui
S3_BUCKET_PROD=netimobiliaria-prod
S3_BUCKET_STAGING=netimobiliaria-staging

# ── Cron ─────────────────────────────────────────────────────
PROD_CRON_SECRET=segredo_cron_aqui
STAGING_CRON_SECRET=segredo_cron_staging_aqui

# ── URLs de build (contextos Docker) ─────────────────────────
# Normalmente apontam para o mesmo diretório na VPS.
PROD_CONTEXT=.
STAGING_CONTEXT=.

# ── App URLs ─────────────────────────────────────────────────
PROD_APP_URL=https://app.seudominio.com.br
STAGING_APP_URL=https://staging.seudominio.com.br

# ── LLM (fallback global) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── Meta Marketing API (fallback global) ─────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Notificações (opcionais) ──────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
SLACK_WEBHOOK_URL=
