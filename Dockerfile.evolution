# atendai/evolution-api não resolve mais no Docker Hub (organização migrou publicação da
# imagem para evoapicloud) — versão fixa, confirmada resolvível antes de trocar.
FROM evoapicloud/evolution-api:v2.3.7

# Baileys 7.x (rc14): resolve @lid para número real via remoteJidAlt (validado no container de
# teste netimobiliaria-evolution-lid-test). A 6.7.x não expõe o mapeamento LID→número.
WORKDIR /evolution
RUN npm install baileys@7.0.0-rc14 --legacy-peer-deps --no-fund --no-audit
