# =============================================================
# deploy.secrets.env — segredos reais pra pré-preencher o .env de produção
#
# Este arquivo NUNCA deve ser commitado (já está no .gitignore como
# scripts/deploy.secrets.env). Copie este .example pra scripts/deploy.secrets.env
# e preencha com os valores reais — em QUALQUER máquina onde for rodar
# ./scripts/deploy.sh (local, pra testar, ou direto na VPS).
#
# scripts/deploy.sh detecta este arquivo automaticamente: se existir, os valores
# abaixo pré-preenchem o .env gerado (Google Calendar + SMTP prontos, sem editar
# nada manualmente depois do deploy). Se não existir, o comportamento não muda —
# os campos ficam em branco no .env, como já era antes.
#
# Ver .env.google_calendar.example pro passo a passo completo de como obter cada
# um desses valores (Google Cloud Console + Gmail).
# =============================================================

# OAuth 2.0 — mesmo Client usado em dev, vale pra produção E staging juntas
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service Account — cole o JSON inteiro ENTRE ASPAS SIMPLES, tudo em 1 linha:
#   GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
GOOGLE_SERVICE_ACCOUNT_KEY=

# SMTP — confirmação de agendamento por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Senha de app do Gmail (16 caracteres) — cole SEM espaços, mesmo o Google
# mostrando em 4 blocos de 4 na tela dele.
SMTP_PASS=
# Qualquer valor com espaço precisa de aspas simples (este arquivo também é
# lido via `source` em bash — sem aspas, o espaço quebra a variável no meio).
SMTP_FROM_NAME='Artemis4 CRM'
